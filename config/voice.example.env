# Voice configuration template for Souta Robot Kiosk
# Copy this file to config/voice.local.env or configure variables in config/llm.local.env

# STT (Groq Whisper)
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_STT_LANGUAGE=auto

# Audio input
# Leave blank to use PulseAudio default source (e.g. USB webcam mic)
KIOSK_MIC_SOURCE=
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_MAX_RECORD_SECONDS=15
AUDIO_MIN_RECORD_SECONDS=0.3
AUDIO_SILENCE_TIMEOUT_SECONDS=1.0

# TTS (Edge TTS via 9Router)
KIOSK_TTS_ENABLED=true
KIOSK_TTS_BASE_URL=http://127.0.0.1:20128/v1
KIOSK_TTS_DEFAULT_LANGUAGE=vi
KIOSK_TTS_AUTO_SPEAK=true

# Player
KIOSK_AUDIO_PLAYER=mpv
