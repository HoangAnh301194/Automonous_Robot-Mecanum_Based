<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      
      <!-- Nhánh di chuyển chính (Replanning + FollowPath) -->
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="1.0">
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
            <Sequence name="PlannerRecovery">
              <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
            </Sequence>
          </RecoveryNode>
        </RateController>

        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="FollowPath"/>
          <Sequence name="ControllerQuickRecovery">
            <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
          </Sequence>
        </RecoveryNode>
      </PipelineSequence>

      <!-- Nhánh Recovery Toàn cục (Chạy khi PipelineSequence thất bại) -->
      <!-- Đặt ở đây để không bị gián đoạn bởi Planner -->
      <ReactiveFallback name="GlobalRecoveryFallback">
        <GoalUpdated/>
        
        <Sequence name="UnifiedRecoverySequence">
          <!-- Bước 1: Thông báo sự cố và chờ đợi -->
          <OperatorAlert code="WAITING" message="Phát hiện sự cố điều hướng. Đang chờ xử lý."/>
          <Speak message="Xin vui lòng nhường đường cho robot."/>
          <Wait wait_duration="3.0"/>
          
          <Fallback>
            <!-- Thử chạy tới một khoảng ngắn để thoát kẹt -->
            <Sequence name="TryEscape">
              <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
              <RecoveryProgressGuard distance="0.08" timeout="3.0" global_frame="odom" robot_base_frame="base_footprint">
                <FollowPath path="{path}" controller_id="FollowPath" server_timeout="500"/>
              </RecoveryProgressGuard>
            </Sequence>
            
            <!-- Bước 3: Nếu không thoát được, chuẩn bị lùi -->
            <RecoveryNode number_of_retries="3" name="BackupRecovery">
              <!-- Nhánh thực hiện lùi -->
              <Sequence name="ExecuteBackUp">
                <!-- Bước 4: Kiểm tra an toàn trước khi thông báo -->
                <CheckRearSafety topic="/rear_scan_obstacle" min_distance="0.40" timeout="0.50"/>
                
                <OperatorAlert code="PRE_BACKUP" message="Robot chuẩn bị lùi. Vui lòng giữ khoảng cách."/>
                <Speak message="Robot sẽ lùi lại một chút."/>
                
                <!-- Bước 5: Thực hiện lùi và giám sát liên tục -->
                <ReactiveSequence name="SafeBackUp">
                  <CheckRearSafety topic="/rear_scan_obstacle" min_distance="0.40" timeout="0.50"/>
                  <!-- Không xóa local costmap ở đây để BackUp vẫn còn dữ liệu vật cản tổng thể -->
                  <BackUp backup_dist="0.30" backup_speed="0.10" time_allowance="6.0"/>
                </ReactiveSequence>
                
                <!-- Hoàn thành lùi an toàn, dọn dẹp để thử lập kế hoạch lại -->
                <OperatorAlert code="REPLANNING" message="Đang tính toán lại đường đi."/>
                <Sequence name="ClearBothCostmaps">
                  <ClearEntireCostmap name="ClearLocal" service_name="local_costmap/clear_entirely_local_costmap"/>
                  <ClearEntireCostmap name="ClearGlobal" service_name="global_costmap/clear_entirely_global_costmap"/>
                </Sequence>
              </Sequence>
              
              <!-- Nhánh thất bại (không đủ an toàn hoặc quá trình lùi gặp lỗi) -->
              <Sequence name="BackUpFailed">
                <OperatorAlert code="BACKUP_WAIT" message="Không thể hoàn tất thao tác lùi. Đang chờ thử lại."/>
                <Wait wait_duration="2.0"/>
              </Sequence>
            </RecoveryNode>
          </Fallback>
        </Sequence>
      </ReactiveFallback>

    </RecoveryNode>
  </BehaviorTree>
</root>
