<?xml version="1.0"?>
<robot name="my_diff_drive_robot">

  <!-- ========================= -->
  <!-- Materials                 -->
  <!-- ========================= -->
  <material name="blue">
    <color rgba="0 0 0.8 1"/>
  </material>

  <material name="green">
    <color rgba="0 1 0 1"/>
  </material>

  <material name="red">
    <color rgba="1 0 0 1"/>
  </material>

  <material name="grey">
    <color rgba="0.5 0.5 0.5 1"/>
  </material>

  <material name="silver">
    <color rgba="0.75 0.75 0.75 1"/>
  </material>

  <material name="black">
    <color rgba="0 0 0 1"/>
  </material>

  <material name="chassis_mat">
    <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1"/>
  </material>

  <material name="wheel_mat">
    <color rgba="0.75294 0.75294 0.75294 1"/>
  </material>

  <!-- ========================= -->
  <!-- Base Footprint            -->
  <!-- ========================= -->
  <link name="base_footprint"/>

  <!--
    In SolidWorks coordinates, drive wheel axle is at Z = 0.055472 m.
    Drive wheel radius is R = 0.085998 m.
    Bottom of drive wheels: Z = 0.055472 - 0.085998 = -0.030526 m.
    To place base_footprint tangent to the ground plane (Z = 0):
    base_joint origin Z is set to 0.030526 m.
  -->
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.030526" rpy="0 0 0"/>
  </joint>

  <!-- ========================= -->
  <!-- Base Link (SolidWorks CAD) -->
  <!-- Normalized origin: Midpoint of drive wheels at X=0, Y=0 -->
  <!-- Offset from SolidWorks origin: dX = 0.18805 m, dY = 0.21300 m -->
  <!-- ========================= -->
  <link name="base_link">
    <inertial>
      <!-- Center of mass shifted by dX = 0.18805, dY = 0.2130 -->
      <origin xyz="0.033360511 0.0000017 0.03538706" rpy="0 0 0"/>
      <mass value="1.25495205"/>
      <inertia ixx="0.02042045" ixy="1.149356E-06" ixz="0.00131466"
               iyy="0.02975992" iyz="1.67329E-08"
               izz="0.04933740"/>
    </inertial>

    <visual>
      <origin xyz="-0.18805 -0.2130 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mo_hinh/meshes/base_link.STL"/>
      </geometry>
      <material name="chassis_mat"/>
    </visual>

    <!-- Simplified box collision to avoid heavy Gazebo collision computations -->
    <collision>
      <origin xyz="0.02 0.0 0.06869" rpy="0 0 0"/>
      <geometry>
        <box size="0.62 0.54 0.085"/>
      </geometry>
    </collision>
  </link>

  <!-- ========================= -->
  <!-- Drive Wheels (Diff Drive) -->
  <!-- Left Wheel                -->
  <!-- ========================= -->
  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <origin xyz="0 0.2534 0.055472" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="wheel_left_link">
    <inertial>
      <origin xyz="-5.0984E-06 -0.033015 7.7331E-06" rpy="0 0 0"/>
      <mass value="0.79711"/>
      <inertia ixx="0.0016716" ixy="3.0102E-08" ixz="-3.8937E-08"
               iyy="0.0030919" iyz="1.8966E-07"
               izz="0.0016716"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mo_hinh/meshes/wheel_left_link.STL"/>
      </geometry>
      <material name="wheel_mat"/>
    </visual>

    <!-- Simplified cylinder collision along rotation axis Y -->
    <collision>
      <origin xyz="0 -0.0567 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.085998" length="0.1134"/>
      </geometry>
    </collision>
  </link>

  <!-- ========================= -->
  <!-- Right Wheel               -->
  <!-- ========================= -->
  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <origin xyz="0 -0.2534 0.055472" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="wheel_right_link">
    <inertial>
      <origin xyz="5.0984E-06 0.033015 7.7331E-06" rpy="0 0 0"/>
      <mass value="0.79711"/>
      <inertia ixx="0.0016716" ixy="3.0102E-08" ixz="3.8937E-08"
               iyy="0.0030919" iyz="-1.8966E-07"
               izz="0.0016716"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mo_hinh/meshes/wheel_right_link.STL"/>
      </geometry>
      <material name="wheel_mat"/>
    </visual>

    <!-- Simplified cylinder collision along rotation axis Y -->
    <collision>
      <origin xyz="0 0.0567 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.085998" length="0.1134"/>
      </geometry>
    </collision>
  </link>

  <!-- ========================= -->
  <!-- Caster Wheels (Bánh phụ)  -->
  <!-- 1. Bánh phụ trước (Front) -->
  <!-- ========================= -->
  <joint name="caster_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_front_link"/>
    <origin xyz="0.27378 0.019 -0.0023223" rpy="0 0 0"/>
  </joint>

  <link name="caster_front_link">
    <inertial>
      <origin xyz="-0.0051384 -0.019049 0.0083478" rpy="0 0 0"/>
      <mass value="0.06026"/>
      <inertia ixx="2.3601E-05" ixy="1.4688E-08" ixz="7.1694E-06"
               iyy="3.2253E-05" iyz="-2.4004E-08"
               izz="1.8571E-05"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mo_hinh/meshes/caster_front_Link.STL"/>
      </geometry>
      <material name="chassis_mat"/>
    </visual>

    <!-- Sphere collision centered on the wheel contact patch -->
    <collision>
      <origin xyz="0 -0.019 -0.003204" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.025"/>
      </geometry>
    </collision>
  </link>

  <!-- ========================= -->
  <!-- 2. Bánh phụ trái (Left)   -->
  <!-- ========================= -->
  <joint name="caster_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_left_link"/>
    <origin xyz="-0.18805 0.20898 -3.3809E-05" rpy="0 0 0"/>
  </joint>

  <link name="caster_left_link">
    <inertial>
      <origin xyz="-0.0080178 -0.019209 0.06248" rpy="0 0 0"/>
      <mass value="0.12754"/>
      <inertia ixx="6.4519E-05" ixy="1.3465E-08" ixz="7.1762E-06"
               iyy="7.2379E-05" iyz="-2.3834E-08"
               izz="3.9114E-05"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mo_hinh/meshes/caster_left_link.STL"/>
      </geometry>
      <material name="wheel_mat"/>
    </visual>

    <!-- Sphere collision centered on the wheel contact patch -->
    <collision>
      <origin xyz="0 -0.019 -0.005492" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.025"/>
      </geometry>
    </collision>
  </link>

  <!-- ========================= -->
  <!-- 3. Bánh phụ phải (Right)  -->
  <!-- Correct assembly joint origin (candidate 1 from SolidWorks URDF) -->
  <!-- ========================= -->
  <joint name="caster_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_right_link"/>
    <origin xyz="-0.18805 -0.2130 0" rpy="0 0 0"/>
  </joint>

  <link name="caster_right_link">
    <inertial>
      <origin xyz="-0.0080095 0.022791 0.062472" rpy="0 0 0"/>
      <mass value="0.12754"/>
      <inertia ixx="6.4519E-05" ixy="1.3465E-08" ixz="7.1762E-06"
               iyy="7.2379E-05" iyz="-2.3834E-08"
               izz="3.9114E-05"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mo_hinh/meshes/caster_right_Link.STL"/>
      </geometry>
      <material name="wheel_mat"/>
    </visual>

    <!-- Sphere collision centered on the wheel contact patch -->
    <collision>
      <origin xyz="0 0.023 -0.005518" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.025"/>
      </geometry>
    </collision>
  </link>

  <!-- ========================= -->
  <!-- Gazebo Friction Settings  -->
  <!-- ========================= -->
  <gazebo reference="wheel_left_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="wheel_right_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="caster_front_link">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
  </gazebo>

  <gazebo reference="caster_left_link">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
  </gazebo>

  <gazebo reference="caster_right_link">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
  </gazebo>

  <!-- ========================= -->
  <!-- IMU                       -->
  <!-- ========================= -->
  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.02 0.02 0.01"/>
      </geometry>
      <material name="green"/>
    </visual>

    <collision>
      <geometry>
        <box size="0.02 0.02 0.01"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="1e-5" ixy="0.0" ixz="0.0"
               iyy="1e-5" iyz="0.0"
               izz="1e-5"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.055" rpy="0 0 0"/>
  </joint>

  <!-- ========================= -->
  <!-- 2D LiDAR Link (CAD)       -->
  <!-- ========================= -->
  <link name="laser_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 3.14159265"/>
      <geometry>
        <mesh filename="package://mo_hinh/meshes/laser_Link.STL"/>
      </geometry>
      <material name="silver"/>
    </visual>

    <inertial>
      <origin xyz="-0.011792 0.00036789 -0.035501" rpy="0 0 3.14159265"/>
      <mass value="0.094104"/>
      <inertia ixx="2.7909E-05" ixy="-5.2518E-08" ixz="-3.3534E-07"
               iyy="4.4353E-05" iyz="2.4873E-08"
               izz="6.9475E-05"/>
    </inertial>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="-0.175 0.0 0.24949" rpy="3.14159265 0 0"/>
  </joint>

  <!-- ========================= -->
  <!-- Support Link              -->
  <!-- ========================= -->
  <link name="support_link">
    <visual>
      <geometry>
        <box size="0.02 0.02 0.50"/>
      </geometry>
      <material name="grey"/>
    </visual>

    <collision>
      <geometry>
        <box size="0.02 0.02 0.50"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="2e-4" ixy="0.0" ixz="0.0"
               iyy="2e-4" iyz="0.0"
               izz="1e-5"/>
    </inertial>
  </link>

  <joint name="support_joint" type="fixed">
    <parent link="base_link"/>
    <child link="support_link"/>
    <origin xyz="-0.22 0.0 0.25" rpy="0 0 0"/>
  </joint>

  <!-- ========================= -->
  <!-- Camera Link               -->
  <!-- ========================= -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.025 0.09 0.025"/>
      </geometry>
      <material name="silver"/>
    </visual>

    <collision>
      <geometry>
        <box size="0.025 0.09 0.025"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.10"/>
      <inertia ixx="5e-5" ixy="0.0" ixz="0.0"
               iyy="5e-5" iyz="0.0"
               izz="5e-5"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="-0.25 0.0 0.50" rpy="0 0.698132 3.14159265"/>
  </joint>

  <!-- Optical frame -->
  <link name="camera_color_optical_frame">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.0001"/>
      <inertia ixx="1e-9" ixy="0.0" ixz="0.0"
               iyy="1e-9" iyz="0.0"
               izz="1e-9"/>
    </inertial>
  </link>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- Depth Optical frame -->
  <link name="camera_depth_optical_frame">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.0001"/>
      <inertia ixx="1e-9" ixy="0.0" ixz="0.0"
               iyy="1e-9" iyz="0.0"
               izz="1e-9"/>
    </inertial>
  </link>

  <joint name="camera_depth_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- ========================= -->
  <!-- Rear Camera Link          -->
  <!-- ========================= -->
  <link name="rear_camera_link">
    <visual>
      <geometry>
        <box size="0.025 0.09 0.025"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.025 0.09 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.10"/>
      <inertia ixx="5e-5" ixy="0.0" ixz="0.0"
               iyy="5e-5" iyz="0.0"
               izz="5e-5"/>
    </inertial>
  </link>

  <joint name="rear_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_camera_link"/>
    <origin xyz="0.25 0.0 0.25" rpy="0 0.698132 0"/>
  </joint>

  <!-- Rear Depth Optical frame -->
  <link name="rear_camera_depth_optical_frame">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.0001"/>
      <inertia ixx="1e-9" ixy="0.0" ixz="0.0"
               iyy="1e-9" iyz="0.0"
               izz="1e-9"/>
    </inertial>
  </link>

  <joint name="rear_camera_depth_optical_joint" type="fixed">
    <parent link="rear_camera_link"/>
    <child link="rear_camera_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- Rear Scan Frame -->
  <link name="rear_scan_frame"/>

  <joint name="rear_scan_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_scan_frame"/>
    <origin xyz="0.25 0.0 0.0" rpy="0 0 0"/>
  </joint>

  <!-- ========================= -->
  <!-- Gazebo Sim Plugins        -->
  <!-- ========================= -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.5068</wheel_separation>
      <wheel_radius>0.086</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration>
      <max_linear_velocity>1.0</max_linear_velocity>
      <min_linear_velocity>-1.0</min_linear_velocity>
      <max_angular_velocity>2.0</max_angular_velocity>
      <min_angular_velocity>-2.0</min_angular_velocity>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publisher_frequency>50</odom_publisher_frequency>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>wheel_left_joint</joint_name>
      <joint_name>wheel_right_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- IMU Sensor -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100.0</update_rate>
      <visualize>false</visualize>
      <topic>imu/data</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- 2D LiDAR Sensor -->
  <gazebo reference="laser_link">
    <sensor name="lidar_sensor" type="gpu_lidar">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>12.0</update_rate>
      <topic>scan</topic>
      <gz_frame_id>laser_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- Front Camera Sensors (Depth) -->
  <gazebo reference="camera_link">
    <sensor name="front_depth_camera" type="depth_camera">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>15.0</update_rate>
      <topic>front_camera/depth/image_raw</topic>
      <gz_frame_id>camera_link</gz_frame_id>
      <camera name="front_depth_camera">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- Rear Camera Sensors (Depth) -->
  <gazebo reference="rear_camera_link">
    <sensor name="rear_depth_camera" type="depth_camera">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>15.0</update_rate>
      <topic>rear_camera/depth/image_raw</topic>
      <gz_frame_id>rear_camera_link</gz_frame_id>
      <camera name="rear_depth_camera">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- ========================= -->
  <!-- ros2_control Hardware Tag -->
  <!-- ========================= -->
  <ros2_control name="hoverboard_system" type="system">
    <hardware>
      <plugin>hoverboard_driver/hoverboard_driver</plugin>
      <param name="wheel_radius">0.08255</param>
      <param name="max_velocity">1.0</param>
      <param name="device">/dev/hoverboard</param>
    </hardware>
    <joint name="wheel_left_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wheel_right_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

</robot>

