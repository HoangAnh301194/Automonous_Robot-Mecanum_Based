<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="uwb_nlos_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Standard Gazebo Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <!-- Custom UWB DWM3000 Simulation System Plugin -->
    <plugin filename="libuwb_system.so" name="uwb_dwm3000_sim::UwbSystem">
      <update_rate>20.0</update_rate>
      <z_height>1.0</z_height>
      <max_range>35.0</max_range>
      <sigma_los>0.05</sigma_los>
      <sigma_nlos>0.25</sigma_nlos>
      <nlos_bias_base>0.15</nlos_bias_base>
      <k_attenuation>1.5</k_attenuation>
      <target_model>uwb_robot</target_model>
    </plugin>

    <!-- Sun Light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Outer Boundary Walls -->
    <model name="wall_south">
      <static>true</static>
      <pose>5.0 0.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10.0 0.3 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.0 0.3 3.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <pose>5.0 8.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10.0 0.3 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.0 0.3 3.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>0.0 4.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 8.0 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 8.0 3.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>10.0 4.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 8.0 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 8.0 3.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Center Obstacle Wall causing NLOS -->
    <model name="wall_middle">
      <static>true</static>
      <pose>5.0 4.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 5.0 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 5.0 3.0</size></box></geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.8 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Target Robot Entity -->
    <model name="uwb_robot">
      <pose>2.0 2.0 0.2 0 0 0</pose>
      <link name="base_link">
        <inertial>
          <mass>5.0</mass>
          <inertia>
            <ixx>0.1</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.1</iyy><iyz>0</iyz>
            <izz>0.1</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.25</radius><length>0.3</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>0.3</length></cylinder></geometry>
          <material><ambient>0.0 0.8 0.2 1</ambient></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
