              <size>1.0 0.45 1.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.4 0.4 1</ambient>
            <diffuse>0.5 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="pillar_1">
      <static>true</static>
      <pose>2.5 -2.0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.25</radius>
