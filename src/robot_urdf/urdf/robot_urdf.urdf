               iyy="1e-5" iyz="0.0"
               izz="1e-5"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.18805 0.213 0.08" rpy="0 0 3.14159265"/>
  </joint>

  <!-- ========================= -->
  <!-- 2D LiDAR (laser_link)     -->
  <!-- ========================= -->
  <link
    name="laser_link">
    <inertial>
      <origin
        xyz="0.011792 -0.00036789 -0.035501"
        rpy="0 0 0" />
      <mass
        value="0.094104" />
      <inertia
        ixx="2.7909E-05"
        ixy="-5.2518E-08"
        ixz="-3.3534E-07"
        iyy="4.4353E-05"
        iyz="2.4873E-08"
