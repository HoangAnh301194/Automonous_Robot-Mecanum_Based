      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://robot_urdf/meshes/laser_Link.STL" />
      </geometry>
    </collision>
  </link>

  <joint
    name="laser_joint"
    type="fixed">
    <origin
      xyz="0.01305 0.213 0.24949"
      rpy="3.14159265 0 3.14159265" />
    <parent
      link="base_link" />
    <child
      link="laser_link" />
    <axis
      xyz="0 0 0" />
  </joint>

  <!-- ========================= -->
  <!-- Left Wheel (Active, 43cm) -->
  <!-- ========================= -->
  <link
    name="wheel_left_link">
    <inertial>
      <origin
        xyz="-5.0984E-06 -0.033015 7.7331E-06"
        rpy="0 0 0" />
      <mass
        value="0.79711" />
      <inertia
        ixx="0.0016716"
        ixy="3.0102E-08"
        ixz="-3.8937E-08"
        iyy="0.0030919"
        iyz="1.8966E-07"
        izz="0.0016716" />
    </inertial>
    <visual>
      <origin
