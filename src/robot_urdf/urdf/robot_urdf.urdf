        <color
          rgba="0.75294 0.75294 0.75294 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 -0.0567 0"
        rpy="1.5707963 0 0" />
      <geometry>
        <cylinder radius="0.086" length="0.05" />
      </geometry>
    </collision>
  </link>

  <joint
    name="wheel_left_joint"
    type="continuous">
    <origin
      xyz="0.18805 -0.002 0.055472"
      rpy="0 0 0" />
    <parent
      link="base_link" />
    <child
      link="wheel_right_link" />
    <axis
      xyz="0 -1 0" />
  </joint>

  <!-- ========================= -->
  <!-- Right Wheel (Active, 43cm)-->
  <!-- ========================= -->
  <link
    name="wheel_right_link">
    <inertial>
      <origin
        xyz="5.0984E-06 0.033015 7.7331E-06"
        rpy="0 0 0" />
      <mass
        value="0.79711" />
      <inertia
        ixx="0.0016716"
        ixy="3.0102E-08"
        ixz="3.8937E-08"
        iyy="0.0030919"
        iyz="-1.8966E-07"
        izz="0.0016716" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://robot_urdf/meshes/wheel_right_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.75294 0.75294 0.75294 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0.0567 0"
        rpy="1.5707963 0 0" />
      <geometry>
        <cylinder radius="0.086" length="0.05" />
      </geometry>
    </collision>
  </link>

  <joint
    name="wheel_right_joint"
    type="continuous">
    <origin
      xyz="0.18805 0.428 0.055472"
      rpy="0 0 0" />
    <parent
      link="base_link" />
    <child
      link="wheel_left_link" />
    <axis
      xyz="0 -1 0" />
  </joint>

  <!-- ========================= -->
  <!-- Front Caster Wheel        -->
  <!-- ========================= -->
  <link
    name="caster_front_link">
    <inertial>
      <origin
        xyz="-0.0051384 -0.019049 0.0083478"
        rpy="0 0 0" />
      <mass
        value="0.06026" />
      <inertia
        ixx="2.3601E-05"
        ixy="1.4688E-08"
        ixz="7.1694E-06"
        iyy="3.2253E-05"
        iyz="-2.4004E-08"
        izz="1.8571E-05" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://robot_urdf/meshes/caster_front_Link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="-0.0137 -0.019 -0.012"
        rpy="0 0 0" />
      <geometry>
        <sphere radius="0.0125" />
      </geometry>
    </collision>
  </link>

  <joint
    name="caster_front_joint"
    type="fixed">
    <origin
      xyz="0.46183 0.232 -0.0023223"
      rpy="0 0 0" />
    <parent
      link="base_link" />
    <child
      link="caster_front_link" />
  </joint>

  <!-- ========================= -->
  <!-- Rear Left Caster Wheel    -->
  <!-- ========================= -->
  <link
    name="caster_left_link">
    <inertial>
      <origin
        xyz="-0.0080178 -0.019209 0.06248"
        rpy="0 0 0" />
      <mass
        value="0.12754" />
      <inertia
        ixx="6.4519E-05"
        ixy="1.3465E-08"
        ixz="7.1762E-06"
        iyy="7.2379E-05"
